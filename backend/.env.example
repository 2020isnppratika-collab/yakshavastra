# Database Configuration (Atlas or local MongoDB)
# Leave as mongodb://localhost:27017 for automatic in-memory fallback engine if MongoDB is not installed
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=yakshagana_rentals
USE_IN_MEMORY_DB_FALLBACK=true

# Security
JWT_SECRET=yakshagana_secret_key_demo_2026_coastal_karnataka
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Payments (Razorpay Test Mode)
RAZORPAY_KEY_ID=rzp_test_Yaksha2026Demo
RAZORPAY_KEY_SECRET=yaksha_secret_sample_key_98765
RAZORPAY_WEBHOOK_SECRET=yaksha_webhook_secret_12345
ENABLE_MOCK_PAYMENT=true

# Booking & Operations
HOLD_MINUTES=10
DEFAULT_BUFFER_DAYS=1
TAX_RATE=0.05

# Demo Accounts
ADMIN_SEED_EMAIL=admin@demo.com
ADMIN_SEED_PASSWORD=Admin@123
CUSTOMER_SEED_EMAIL=customer@demo.com
CUSTOMER_SEED_PASSWORD=Customer@123
